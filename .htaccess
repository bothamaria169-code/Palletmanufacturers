Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force https + no www on the live domain (skipped on localhost)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L]
  # Turn on once AutoSSL has issued the certificate (remove the # on the 4 lines below):
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  # RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Old WordPress shop links → new pages
  RewriteRule ^shop/?$ shop.php [R=301,L]
  RewriteRule ^product-category/(?:[^/]+/)*([^/]+)/?$ shop.php?cat=$1 [R=301,L]
  RewriteRule ^product/([^/]+)/?$ product.php?s=$1 [R=301,L]
  RewriteRule ^about-us/?$ about.php [R=301,L]
  RewriteRule ^contact-us/?$ contact.php [R=301,L]
  RewriteRule ^swiftpallets-return-policy/?$ returns.php [R=301,L]
  RewriteRule ^(cart|checkout)/?$ quote.php [R=301,L]
  RewriteRule ^my-account/?$ dashboard.php [R=301,L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Code and data are never served directly
  RewriteRule ^(config|includes|classes|database|vendor|docs|_scrape|\.git|\.claude)(/|$) - [F,L]
</IfModule>

<FilesMatch "(\.(sql|md|lock|phar|log|bak|env|json|py)|^\.cpanel\.yml|^\.gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/webp "access plus 90 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType image/jpeg "access plus 90 days"
</IfModule>
